# --- Illustration engine (server-side only) ---
# Default provider is Google Gemini Flash Image ("Nano Banana 2").
# Get a key at https://aistudio.google.com/apikey
IMAGE_PROVIDER=gemini
GEMINI_API_KEY=

# Optional overrides — only set these if you want to pin a specific Gemini
# model instead of the app's built-in default (both live on Google's Flash
# tier, chosen for price + character consistency, not photorealism):
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# GEMINI_TEXT_MODEL=gemini-3.7-flash

# Optional: swap in a different provider later without code changes.
# OPENAI_API_KEY=

# --- Optional cloud sync / multi-device backup (Supabase) ---
# The app is fully functional WITHOUT these — data lives locally in the browser
# (IndexedDB). Fill these in only if you want cloud backup + multi-device sync.
# When these are set, a login gate is enabled; when blank, the app runs
# single-user with no login.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL (used for the KDP deep-link return, PWA, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000
